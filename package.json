{
  "name": "@the-open-engine/personal-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "openclaw gateway run",
    "doctor": "node --import tsx scripts/onboard.mjs doctor --json",
    "demo": "tsx src/demo.ts",
    "test": "node --import ./test/profile-fixture.mjs --import tsx --test test/*.test.ts deploy/openclaw/action-preview/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check && npm run build",
    "onboard": "npm run build && node --import tsx scripts/onboard.mjs",
    "onboard:plan": "node --import tsx scripts/onboard.mjs plan --json",
    "onboard:doctor": "node --import tsx scripts/onboard.mjs doctor --json",
    "onboard:apply": "node --import tsx scripts/onboard.mjs apply",
    "legacy:start": "node dist/cli.js start",
    "legacy:doctor": "tsx src/cli.ts doctor",
    "legacy:dev": "tsx src/cli.ts start"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
