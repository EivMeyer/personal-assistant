<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:{{HOME}}/.local/bin</string>
	</dict>
	<key>Label</key>
	<string>com.theopenengine.secretary-recovery</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HOME}}/.local/share/openclaw-runtime/node_modules/node/bin/node</string>
		<string>{{REPO}}/deploy/openclaw/action-preview/recovery-watch.mjs</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/openclaw/recovery.log</string>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/openclaw/recovery.log</string>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>{{REPO}}</string>
</dict>
</plist>
